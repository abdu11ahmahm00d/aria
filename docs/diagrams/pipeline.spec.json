    { "id": "e2", "from": "collector", "to": "detector", "variant": "emphasis", "role": "main" },
    { "id": "e3", "from": "detector", "to": "synthesizer", "variant": "emphasis", "role": "main" },
    { "id": "e4", "from": "synthesizer", "to": "report", "variant": "emphasis", "role": "main" },
    { "id": "x1", "from": "collector", "to": "halt", "variant": "security", "role": "error" },
    { "id": "x2", "from": "detector", "to": "halt", "variant": "security", "role": "error" },
    { "id": "x3", "from": "synthesizer", "to": "halt", "variant": "security", "role": "error" }
