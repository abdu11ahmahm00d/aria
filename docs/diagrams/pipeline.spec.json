    { "id": "csvs", "lane": "a", "col": 0, "type": "external", "label": "3 CSV Files", "sublabel": "3 CSVs" },
    { "id": "detector", "lane": "a", "col": 2, "type": "backend", "label": "Detector", "sublabel": "4 checkers" },
    { "id": "report", "lane": "a", "col": 4, "type": "database", "label": "Audit Report", "sublabel": "flags.json" },
    { "id": "collector", "lane": "b", "col": 1, "type": "backend", "label": "Collector", "sublabel": "validate" },
    { "id": "synthesizer", "lane": "b", "col": 3, "type": "backend", "label": "Synthesizer", "sublabel": "severity" },
